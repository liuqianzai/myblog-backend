# 环境变量示例（复制后按需注入，切勿把真实值提交进仓库）
# 说明：Spring Boot 支持宽松绑定，MYSQL_PASSWORD 等价于 spring.datasource.password，
#       BLOG_AUTH_JWT_SECRET 等价于 blog.auth.jwt-secret。
# 本地开发也可以把这些值写进 application-local.yml（已被 .gitignore 排除）。

MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password

# JWT 签名密钥，必须至少 32 位随机字符串，缺失或过短会导致应用启动失败
BLOG_AUTH_JWT_SECRET=please_generate_a_random_secret_at_least_32_chars

# 密码加盐值，不再提供代码内默认值
BLOG_AUTH_PASSWORD_SALT=your_password_salt

BLOG_UPLOAD_DIR=uploads
